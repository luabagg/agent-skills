{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated Agent Tools",
  "type": "object",
  "required": ["version", "tools"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "description", "source", "package", "install", "commands", "agentUse"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["npm-package", "cli", "app", "tool-reference", "documentation"]
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": ["string", "null"]
          },
          "package": {
            "type": ["string", "null"]
          },
          "install": {
            "type": ["string", "null"]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "command", "purpose"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                }
              }
            }
          },
          "agentUse": {
            "type": "string"
          }
        }
      }
    }
  }
}
