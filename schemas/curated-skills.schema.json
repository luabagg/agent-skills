{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated Agent Skills",
  "type": "object",
  "required": ["version", "agents", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "installPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultMethod": {
          "type": "string",
          "enum": ["symlink", "copy"]
        },
        "copyFallback": {
          "type": "string"
        },
        "installer": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "source", "sourceType", "preferredInstall", "skills"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "sourceType": {
            "type": "string",
            "enum": ["github", "git", "plugin"]
          },
          "preferredInstall": {
            "type": "string",
            "enum": ["skills-cli", "plugin", "manual"]
          },
          "notes": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
