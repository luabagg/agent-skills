{
  "name": "personal-agent-skills",
  "version": "0.1.0",
  "description": "Personal agent skills and a curated third-party skill install list.",
  "private": false,
  "type": "module",
  "bin": {
    "agent-skills": "./scripts/cli.mjs"
  },
  "scripts": {
    "agent-skills": "node scripts/cli.mjs",
    "skills:list": "node scripts/cli.mjs skills list",
    "skills:list:installed": "node scripts/cli.mjs skills list --installed",
    "skills:list:installed:json": "node scripts/cli.mjs skills list --installed --json",
    "install:skills": "node scripts/cli.mjs install skills",
    "install:curated": "node scripts/cli.mjs install curated",
    "install:curated:dry-run": "node scripts/cli.mjs install curated --dry-run",
    "install:agents": "node scripts/cli.mjs install agents",
    "setup:memory-palace": "node scripts/cli.mjs setup memory-palace",
    "setup:opencode": "node scripts/cli.mjs setup opencode",
    "setup:opencode:dry-run": "node scripts/cli.mjs setup opencode --dry-run",
    "setup:cursor": "node scripts/cli.mjs setup cursor",
    "setup:cursor:dry-run": "node scripts/cli.mjs setup cursor --dry-run",
    "setup:cursor:copy": "node scripts/cli.mjs setup cursor --copy",
    "setup:pi": "node scripts/cli.mjs setup pi",
    "setup:pi:dry-run": "node scripts/cli.mjs setup pi --dry-run",
    "catalog:check": "node scripts/cli.mjs catalog check",
    "catalog:diff": "node scripts/cli.mjs catalog diff",
    "catalog:refresh": "node scripts/cli.mjs catalog refresh",
    "setup": "node scripts/cli.mjs install all",
    "setup:copy": "node scripts/cli.mjs install all --copy",
    "update:skills": "node scripts/cli.mjs update",
    "verify": "node scripts/cli.mjs verify"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "copilot",
    "opencode",
    "pi",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
